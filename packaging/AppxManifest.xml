<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. build-msix.ps1 fills in the $...$ values;
     IdentityName, Publisher and PublisherDisplayName must match Partner Center
     (Product management > Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>$DisplayName$</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Persian (Solar Hijri) calendar in the Windows taskbar.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="fa-IR" />
  </Resources>

  <Applications>
    <Application Id="Khorshid" Executable="Khorshid.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DisplayName$"
        Description="Persian (Solar Hijri) calendar in the Windows taskbar"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off by default; the tray menu opens Settings > Apps > Startup to switch it on. -->
        <desktop:Extension Category="windows.startupTask" Executable="Khorshid.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="KhorshidStartup" Enabled="false" DisplayName="$DisplayName$" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
